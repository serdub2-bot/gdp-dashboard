    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node -e \"const{spawnSync}=require('child_process'),p=require('path');const r=process.env.DEVIN_PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT;if(!r)process.exit(0);const x=spawnSync(process.execPath,[p.join(r,'hooks','devin','dispatch.mjs'),'SessionStart'],{stdio:'inherit'});process.exit(typeof x.status==='number'?x.status:0)\"",
          "timeout": 60
        }
      ]
    }
  ],
